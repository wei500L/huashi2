COMPOSE_PROJECT_NAME=ef-transfer

APP_SERVER_PORT=8080
AI_GATEWAY_PORT=8090

APP_DB_NAME=ef_transfer_app
APP_DB_USERNAME=ef_user
APP_DB_PASSWORD=ef_password
APP_DB_ROOT_PASSWORD=ef_root_password
APP_DB_PORT=3306
APP_DB_SSL_MODE=REQUIRED

AI_DB_NAME=ef_transfer_ai
AI_DB_USERNAME=ef_ai
AI_DB_PASSWORD=ef_ai_password
AI_DB_PORT=5432

REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=replace-with-a-strong-redis-password

RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=ef_admin
RABBITMQ_PASSWORD=ef_password
RABBITMQ_VHOST=/

APP_OPS_CONFIG_ENCRYPTION_SECRET=replace-me-with-a-dedicated-32-byte-minimum-secret-key
APP_JWT_ACTIVE_KID=current
APP_JWT_KEYS_0_KID=current
# Generate with a cryptographically random source, for example: openssl rand -base64 48
APP_JWT_KEYS_0_SECRET=replace-me-with-a-32-byte-minimum-secret-key
APP_JWT_KEYS_1_KID=previous
APP_JWT_KEYS_1_SECRET=
APP_JWT_LEGACY_SECRET=
APP_JWT_ISSUER=ef-transfer-platform
APP_JWT_ACCESS_TTL=PT30M
APP_JWT_REFRESH_TTL=PT168H
APP_DB_POOL_MAX_SIZE=16
APP_DB_POOL_MIN_IDLE=4
APP_DB_POOL_CONNECTION_TIMEOUT=3000
APP_DB_POOL_IDLE_TIMEOUT=600000
APP_DB_POOL_MAX_LIFETIME=1800000
APP_AUTH_LOCKOUT_ENABLED=true
APP_AUTH_LOCKOUT_THRESHOLD=5
APP_AUTH_LOCKOUT_DURATION=PT15M
APP_DEMO_DATA_ENABLED=false
PLATFORM_INTERNAL_API_TOKEN=replace-with-shared-internal-token

AI_PROVIDER=qwen
AI_FALLBACK_PROVIDER=deepseek
AI_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_OPENAI_API_KEY=replace-with-dashscope-api-key
AI_CHAT_MODEL=qwen-max
AI_CHAT_TIMEOUT=PT30S
AI_CHAT_TEMPERATURE=0.2
AI_CHAT_MAX_TOKENS=2048
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_TIMEOUT=PT30S
AI_EMBEDDING_DIMENSION=1024
AI_RERANK_MODEL=gte-rerank-v2
AI_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
AI_RERANK_TIMEOUT=PT30S
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_WAIT_DURATION=PT0.5S
AI_CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50
AI_CIRCUIT_BREAKER_SLIDING_WINDOW_SIZE=20
AI_CIRCUIT_BREAKER_OPEN_STATE_DURATION=PT30S

AI_GATEWAY_CONNECT_TIMEOUT=PT3S
AI_GATEWAY_READ_TIMEOUT=PT5S

BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7

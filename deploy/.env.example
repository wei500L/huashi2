COMPOSE_PROJECT_NAME=ef-transfer

APP_SERVER_PORT=8080
AI_GATEWAY_PORT=8090
AI_GATEWAY_MANAGEMENT_PORT=18090
SPRING_PROFILES_ACTIVE=prod
PUBLIC_DOMAIN=huashi.mnari.cn

APP_DB_NAME=ef_transfer_app
APP_DB_USERNAME=ef_user
APP_DB_PASSWORD=ef_password
APP_DB_ROOT_PASSWORD=ef_root_password
APP_DB_PORT=3306
APP_DB_SSL_MODE=REQUIRED

AI_DB_NAME=ef_transfer_ai
AI_DB_USERNAME=ef_ai
AI_DB_PASSWORD=ef_ai_password
AI_DB_PORT=5432

REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=replace-with-a-strong-redis-password

RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=ef_admin
RABBITMQ_PASSWORD=ef_password
RABBITMQ_VHOST=/

APP_OPS_CONFIG_ENCRYPTION_SECRET=replace-me-with-a-dedicated-32-byte-minimum-secret-key
APP_JWT_ACTIVE_KID=current
APP_JWT_KEYS_0_KID=current
# Generate with a cryptographically random source, for example: openssl rand -base64 48
APP_JWT_KEYS_0_SECRET=replace-me-with-a-32-byte-minimum-secret-key
APP_JWT_KEYS_1_KID=previous
APP_JWT_KEYS_1_SECRET=
APP_JWT_LEGACY_SECRET=
APP_JWT_ISSUER=ef-transfer-platform
APP_JWT_ACCESS_TTL=PT30M
APP_JWT_REFRESH_TTL=PT168H
APP_CORS_ALLOWED_ORIGIN_LOCALHOST=http://localhost:3000
APP_CORS_ALLOWED_ORIGIN_LOOPBACK=http://127.0.0.1:3000
# Required for the EF_REFRESH httpOnly cookie. Do not use wildcard origins with credentials.
APP_CORS_ALLOW_CREDENTIALS=true
APP_DB_POOL_MAX_SIZE=16
APP_DB_POOL_MIN_IDLE=4
APP_DB_POOL_CONNECTION_TIMEOUT=3000
APP_DB_POOL_IDLE_TIMEOUT=600000
APP_DB_POOL_MAX_LIFETIME=1800000
APP_ASSESSMENT_SUBMISSION_GRACE_PERIOD=PT3S
# Generate with a cryptographically random source, for example: openssl rand -base64 48
APP_ASSESSMENT_CODE_HMAC_SECRET=replace-me-with-a-32-byte-minimum-assessment-hmac-secret
APP_ASSESSMENT_SENSITIVE_PROFILE_KEY=replace-me-with-a-32-byte-minimum-profile-key
APP_ASSESSMENT_SENSITIVE_PROFILE_KEY_VERSION=v1
# Research PII / IP / bound-file retention. ISO-8601 duration; default P730D.
APP_ASSESSMENT_RESEARCH_RETENTION=P730D
APP_AUTH_LOCKOUT_ENABLED=true
APP_AUTH_LOCKOUT_THRESHOLD=5
APP_AUTH_LOCKOUT_DURATION=PT15M
APP_DEMO_DATA_ENABLED=false
LOG_DIR=/app/logs
LOG_MAX_FILE_SIZE=100MB
LOG_MAX_HISTORY=7
LOG_TOTAL_SIZE_CAP=1GB
TRACING_SAMPLING_PROBABILITY=0.1
OTEL_EXPORTER_ENABLED=false
FRONTEND_PORT=3000
FRONTEND_WATCH_USE_POLLING=true
FRONTEND_WATCH_INTERVAL_MS=300
PLATFORM_INTERNAL_API_TOKEN=replace-me-with-a-shared-high-entropy-internal-token

# Bootstrap-only AI defaults. After an admin saves config, app-server database
# snapshots become authoritative and ai-gateway runtime should be updated from them.
# Real fallback requires dedicated AI_FALLBACK_* values that differ from active
# (URL / key / model). Identical resolved endpoints disable failover at runtime;
# prod/dev config-center notice is error, local/test is warning.
AI_PROVIDER=qwen
AI_FALLBACK_PROVIDER=deepseek
AI_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_OPENAI_API_KEY=replace-with-dashscope-api-key
AI_CHAT_PROTOCOL=openai-compat
AI_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_API_KEY=replace-with-chat-api-key
AI_CHAT_MODEL=qwen-max
AI_CHAT_CONNECT_TIMEOUT=PT3S
AI_CHAT_READ_TIMEOUT=PT180S
AI_CHAT_TEMPERATURE=0.2
AI_CHAT_MAX_TOKENS=8192
AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AI_EMBEDDING_API_KEY=replace-with-qwen3-embedding-api-key
AI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
AI_MULTIMODAL_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
AI_EMBEDDING_CONNECT_TIMEOUT=PT3S
AI_EMBEDDING_READ_TIMEOUT=PT30S
AI_EMBEDDING_DIMENSION=1024
AI_RERANK_PROTOCOL=openai-rerank
AI_RERANK_BASE_URL=https://api.siliconflow.cn/v1
AI_RERANK_API_KEY=replace-with-qwen3-reranker-api-key
AI_RERANK_MODEL=Qwen/Qwen3-Reranker-8B
AI_MULTIMODAL_RERANK_MODEL=Qwen/Qwen3-VL-Reranker-8B
AI_RERANK_CONNECT_TIMEOUT=PT3S
AI_RERANK_READ_TIMEOUT=PT30S
AI_PROVIDER_ALLOW_PRIVATE_NETWORKS=false
AI_PROVIDER_REQUIRE_HTTPS=true
AI_PROVIDER_PROBE_INITIAL_DELAY=PT15S
AI_PROVIDER_PROBE_INTERVAL=PT10M
AI_SCHEDULING_POOL_SIZE=3

# Fallback provider bootstrap settings. Fill these explicitly if you expect failover to use a different upstream.
AI_FALLBACK_CHAT_BASE_URL=
AI_FALLBACK_CHAT_PROTOCOL=
AI_FALLBACK_CHAT_API_KEY=
AI_FALLBACK_CHAT_MODEL=
AI_FALLBACK_CHAT_CONNECT_TIMEOUT=
AI_FALLBACK_CHAT_READ_TIMEOUT=
AI_FALLBACK_CHAT_TEMPERATURE=
AI_FALLBACK_CHAT_MAX_TOKENS=
AI_FALLBACK_EMBEDDING_BASE_URL=
AI_FALLBACK_EMBEDDING_API_KEY=
AI_FALLBACK_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
AI_FALLBACK_MULTIMODAL_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
AI_FALLBACK_EMBEDDING_CONNECT_TIMEOUT=
AI_FALLBACK_EMBEDDING_READ_TIMEOUT=
AI_FALLBACK_EMBEDDING_DIMENSION=
AI_FALLBACK_RERANK_PROTOCOL=
AI_FALLBACK_RERANK_BASE_URL=
AI_FALLBACK_RERANK_API_KEY=
AI_FALLBACK_RERANK_MODEL=
AI_FALLBACK_MULTIMODAL_RERANK_MODEL=Qwen/Qwen3-VL-Reranker-8B
AI_FALLBACK_RERANK_CONNECT_TIMEOUT=
AI_FALLBACK_RERANK_READ_TIMEOUT=

AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_WAIT_DURATION=PT0.5S
AI_CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50
AI_CIRCUIT_BREAKER_SLIDING_WINDOW_SIZE=20
AI_CIRCUIT_BREAKER_OPEN_STATE_DURATION=PT30S
AI_RABBITMQ_LISTENER_PREFETCH=1
AI_RABBITMQ_LISTENER_CONCURRENCY=1
APP_SERVER_BASE_URL=http://app-server:8080
APP_SERVER_CONNECT_TIMEOUT=PT3S
APP_SERVER_READ_TIMEOUT=PT5S
RAG_EXPORT_PAGE_SIZE=100
RAG_EMBEDDING_BATCH_SIZE=32
RAG_RECALL_TOP_K=50
RAG_RECALL_THRESHOLD=0.45
RAG_RERANK_TOP_N=16
RAG_RERANK_THRESHOLD=0.2
RAG_FINAL_TOP_K=8
AI_HNSW_EF_SEARCH=128
AI_HNSW_M=16
AI_HNSW_EF_CONSTRUCTION=128

AI_GATEWAY_CONNECT_TIMEOUT=PT3S
AI_GATEWAY_READ_TIMEOUT=PT180S
AI_GATEWAY_MAX_ATTEMPTS=1

BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
